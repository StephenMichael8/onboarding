# Example environment configuration.
# Copy to `.env.local` (git-ignored) and fill in real values.
# In Vite, only variables prefixed with VITE_ are exposed to client code —
# never put secrets here, since anything shipped to the browser is public.

# Public base URL the app is served from (defaults to './').
# VITE_APP_BASE_URL=/

# Example: analytics or feature-flag keys that are safe to expose publicly.
# VITE_ANALYTICS_ID=
